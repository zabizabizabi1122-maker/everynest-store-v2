{
  "name": "everynest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:seed": "supabase db query --remote --file supabase/seed.sql",
    "db:seed:yes": "supabase db query --remote --file supabase/seed.sql --yes",
    "create:admin": "node scripts/create_admin.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/level1-connectivity.mjs",
    "test:auth": "node scripts/level2-auth-smoke.mjs",
    "test:admin": "node scripts/level3-admin-smoke.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:link": "supabase link",
    "db:push": "supabase db push --remote",
    "db:push:dry": "supabase db push --remote --dry-run",
    "db:migrations": "supabase migration list --remote",
    "db:test": "supabase test db --remote",
    "db:checks": "supabase db query --remote --read-only --file supabase/tests/level1_catalog_checks.sql",
    "db:types": "supabase gen types typescript --remote > src/types/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
