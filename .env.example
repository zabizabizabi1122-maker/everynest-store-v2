# -----------------------------------------------------------------------------
# EveryNest - environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your own Supabase project values.
# `.env.local` is git-ignored. Never commit real keys.
#
# Use a DEVELOPMENT Supabase project for local work. Never point local testing
# at the production project.
#
# Where to find these values:
#   Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------

# The Supabase project URL (not the database connection string).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# The public publishable key (starts with `sb_publishable_`).
# A legacy `anon` JWT key still works for older projects, but do not mix
# conventions inside one project. Never put a secret/service-role key here:
# anything prefixed with NEXT_PUBLIC_ is shipped to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
# Development accounts (populate in .env.local, not version‑controlled)
# EVERYNEST_ADMIN_EMAIL="admin@example.com"
# EVERYNEST_ADMIN_PASSWORD="admin_temp_password"
# EVERYNEST_STAFF_EMAIL="staff@example.com"
# EVERYNEST_STAFF_PASSWORD="staff_temp_password"
# EVERYNEST_CUSTOMER_EMAIL="customer@example.com"
# EVERYNEST_CUSTOMER_PASSWORD="customer_temp_password"
# SUPABASE_SERVICE_ROLE_KEY="sb_service_role_REPLACE_ME"
